# Safe defaults: local monitoring only. Replace placeholders before enabling integrations.
# Example: UNIFI_INFORM_URL=http://<UNIFI_HOST>:8080/inform
UNIFI_INFORM_URL=
# Use exact Huawei SSIDs and existing WLAN _id values (24-hex or UUID, lowercase)
# from your UniFi site. Synthetic example only:
UNIFI_WLAN_MAP={}
# LAN address the CWMP listener binds to. Keep the default loopback in public
# examples; the owner sets the real CPE LAN IP locally.
CWMP_BIND_IP=127.0.0.1
# Leave empty to disable writes. To opt in, use the selected CPEs real management IPs
# (comma separated). Invalid entries are rejected at startup.
HUAWEI_CONTROL_IP=
# Browserless Chrome CDP endpoint for the optional web telemetry collector.
# Placeholder only; point it at your own browserless instance.
BROWSERLESS_URL=ws://<browserless-host>:3000
# Router UI telemetry sources, one https://<router-ip>=<password> pair per router,
# comma separated. Passwords live here only; never commit this file with real values.
WEBROUTERS=https://<router-1-ip>=<password>,https://<router-2-ip>=<password>
# Read-only WEB-ONLY sources: CPEs reachable only through their authenticated
# web API (no usable TR-069), one https://<router-ip>=<password> pair per CPE.
# Empty by default; the owner fills this privately. Never commit real values.
WEB_ONLY_ROUTERS=
# Direct web API transport is primary and never runs alongside browserless for
# the same router. Set to 1 to disable the browserless fallback entirely.
WEBENRICH_DIRECT_ONLY=0
# Explicit LAN opt-in. The CPE UI uses a self-signed certificate: set to false
# only for those private routers. The default verifies TLS everywhere else.
WEBENRICH_VERIFY_TLS=true
# Direct session bounds: client total budget (s), hard wait bound (s) and
# per-request timeout (s). Keep total below the wait bound.
WEBENRICH_DIRECT_TOTAL=25
WEBENRICH_DIRECT_BUDGET=30
WEBENRICH_HTTP_TIMEOUT=8
# Admin control operations (loopback/internal only). Writes are OFF by default.
# An empty token refuses plan/execute/status unconditionally; generate a private
# token only when the server recovers and never commit it here.
HW_OPERATIONS_TOKEN=
# Master write switch (0=off). Keep 0 until an owner explicitly approves.
HW_OPERATIONS_WRITES=0
# Comma-separated write allowlist, e.g.
# wifi.80211r,wifi.twt,wifi.mac_filter.block,wifi.mac_filter.unblock
HW_OPERATIONS_ALLOW=
# Guest password writes cannot be read back (masked); keep 0 to stay fail-closed.
HW_OPERATIONS_UNVERIFIED_WRITES=0
# Destructive reboot needs this one-use approval; keep 0.
HW_OPERATIONS_REBOOT_APPROVED=0
# Operator route to clear a locked operation record; keep 0 unless needed.
HW_OPERATIONS_RESOLVE=0
# Redacted transactional ledger, persisted on the existing webcol-data volume.
HW_OPERATIONS_STATE=/data/operations_state.json
# Optional expected CPE serial per router host (host=serial), comma separated:
# the fresh deviceinfo serial must match or the session is refused.
HW_ROUTER_SERIALS=
# Pinned serial allowlist for WEB_ONLY_ROUTERS, shared by webcol and the bridge
# as `origin=serial` (an explicit canonical origin; no bare/ambiguous serial).
# The origin must be a literal private IP. A web-only CPE whose fresh serial does
# not match is never published. Empty means none are published (fail closed).
WEB_ONLY_SERIALS=
# Optional admin sidecar request timeout in seconds (default 40).
WEBCOL_ADMIN_TIMEOUT=
# Host allowlist for the sidecar admin endpoints (comma separated). Standalone
# default binds loopback; Compose sets the container service name + loopback.
WEBCOL_LISTEN_HOST=127.0.0.1
WEBCOL_ALLOWED_HOSTS=127.0.0.1,localhost
